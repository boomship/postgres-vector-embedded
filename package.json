{
  "name": "@boomship/postgres-vector-embedded",
  "version": "0.3.0",
  "description": "Embedded PostgreSQL with pgvector and pg_trgm extensions for Node.js applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:binaries": "make build",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "check": "biome check --write src",
    "test": "npm run build && node --test tests/*.test.js",
    "prepublishOnly": "npm run build",
    "test:legacy": "node tests/run-all.js"
  },
  "keywords": [
    "postgresql",
    "pgvector",
    "embedded",
    "vector",
    "database",
    "node.js",
    "similarity-search",
    "pg_trgm"
  ],
  "author": "boomship",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boomship/postgres-vector-embedded.git"
  },
  "bugs": {
    "url": "https://github.com/boomship/postgres-vector-embedded/issues"
  },
  "homepage": "https://github.com/boomship/postgres-vector-embedded#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "dist/",
    "examples/",
    "licenses/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "pg": "^8.23.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
